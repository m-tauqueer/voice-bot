{
  "name": "voice-bot",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "frontend",
    "gateway"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:gateway": "npm run dev -w gateway",
    "dev:worker": "uv run --directory worker python -m worker",
    "build:frontend": "npm run build -w frontend",
    "build:gateway": "npm run build -w gateway",
    "typecheck": "npm run typecheck -w frontend && npm run typecheck -w gateway",
    "lint": "biome check gateway/src frontend/vite.config.ts",
    "lint:fix": "biome check --write gateway/src frontend/vite.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  }
}
