# Copy to `.env` in this directory. Never commit `.env`.
# Gateway and worker load this file. Vite (frontend) reads it too; only VITE_* reach the browser.
#
# Required to boot gateway now: local URLs/secrets below + Google Sign-In.
# Optional until later parts: Azure, Deepgram, Engram, OpenAI, BYO_LLM_PUBLIC_URL.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Public URLs / bind ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=4000
GATEWAY_PUBLIC_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:5188
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
WORKER_URL=http://localhost:8000
# Public URL Deepgram will call for BYO-LLM (dev: tunnel; Azure: public worker URL)
# BYO_LLM_PUBLIC_URL=

# --- Frontend (browser-safe; Vite exposes only VITE_*) ---
VITE_GATEWAY_URL=http://localhost:4000

# --- Postgres / Redis (Compose in Part 0.4 will match these) ---
DATABASE_URL=postgresql://voicebot:voicebot@localhost:5432/voicebot
REDIS_URL=redis://localhost:6379

# --- Session (min 16 characters) ---
SESSION_SECRET=replace-with-at-least-16-chars
# Shared secret for gateway ↔ worker. Dedicated; do not reuse SESSION_SECRET.
INTERNAL_API_SECRET=replace-with-a-long-random-secret

# --- Google Sign-In (required now). Redirect must match this URL in Google Cloud Console. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Azure Blob (optional until audio persistence) ---
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_BLOB_CONTAINER=

# --- Deepgram (optional until the voice loop) ---
# DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_STT_LANGUAGE=en
# DEEPGRAM_TTS_VOICE=aura-asteria-en

# --- Engram (optional until the brain) ---
# ENGRAM_API_KEY=
# ENGRAM_ORG_ID=
# ENGRAM_BASE_URL=https://api-engram-alpha.getmetacognition.com
# ENGRAM_TIMEOUT_SECONDS=120

# --- Reframe LLM (optional until the brain) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
