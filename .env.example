# --- Read API (canonical record) ---
# INSIGHTS_PAGE_SIZE=50
# INSIGHTS_MAX_PAGE_SIZE=200
# INSIGHTS_RANGES=today,7d,30d
# INSIGHTS_DEFAULT_RANGE=7d
# Window spec: <id>:<calendar-token> or <id>:<days>
# INSIGHTS_RANGE_WINDOWS=today:calendar,7d:7,30d:30
# INSIGHTS_CALENDAR_WINDOW_SPEC=calendar
# INSIGHTS_TIMEZONE=UTC
# INSIGHTS_ACTIVITY_BUCKETS=hour,day
# INSIGHTS_DEFAULT_BUCKET=day
# INSIGHTS_ERROR_REASONS=server_error,retryable_read,brain_error
# INSIGHTS_BRAIN_MODE_UNRECORDED=unrecorded
# INSIGHTS_BRAIN_MODE_MIXED=mixed
# INSIGHTS_FIRST_WORD_COLUMNS=brain_ms,reframe_first_token_ms
# INSIGHTS_FIRST_WORD_REQUIRED_COLUMN=reframe_first_token_ms
# INSIGHTS_LATENCY_STAGES=stt_ms,brain_ms,reframe_first_token_ms,tts_first_byte_ms
# LATENCY_BUDGET_FIRST_WORD_MS=4000
# LATENCY_BUDGET_P90_MS=8000
# LATENCY_BUDGET_WINDOW_HOURS=24
# LATENCY_BUDGET_BY_BRAIN_MODE={"retrieve":{"p50":4000,"p90":8000},"chat":{"p50":20000,"p90":30000}}
# CORRELATION_ID_HEADER=x-correlation-id
# LOG_TURN_FIELDS=correlation_id,session_id,turn_ids,action,reasons,brain_ms,reframe_ms,reframe_first_token_ms,brain_mode,recorded
# LOG_TURN_EVENT=turn
# LOG_SUBSCRIBE_FORBIDDEN=subscribe_forbidden
# LOG_SUBSCRIBE_FAILED=subscribe_failed
# OPS_SERVICE_GATEWAY=gateway
# OPS_SERVICE_WORKER=worker
# OPS_RECORD_CODES=engram_unavailable,deepgram_unavailable,think_failed,database_unavailable,speaking_llm_failed,record_lost
# OPS_FORCE_CODE=ops_forced
# OPS_FORCE_MESSAGE=Forced dependency failure for the watch probe.
# OPS_LIST_LIMIT=20
# OPS_HEALTH_OK=ok
# OPS_HEALTH_FAIL=fail
# OPS_HEALTH_POSTGRES=postgres
# OPS_HEALTH_REDIS=redis
# OPS_HEALTH_WORKER=worker
# OPS_HEALTH_TIMEOUT_MS=2000
# OPS_LOG_EVENT=ops event
# STATUS_PATH=/status
# STATUS_API_PATH=/api/status
# STATUS_OVERALL_OK=operational
# STATUS_OVERALL_FAIL=disrupted
# STATUS_OVERALL_OK_LABEL=All systems operational
# STATUS_OVERALL_FAIL_LABEL=Some systems are disrupted
# STATUS_COMPONENT_OK=Operational
# STATUS_COMPONENT_FAIL=Disrupted
# STATUS_COMPONENT_LABELS=postgres|Conversation record;redis|Live calls;worker|Persona
# VOICE_NOTICE_KIND_TRACE=trace
# VOICE_NOTICE_TRACE_CODE=turn_traced
# VOICE_NOTICE_TRACE_MESSAGE=Turn recorded.
# ENGRAM_LOGS_LIMIT=50
# Structured `result` values Engram stores on request-log rows.
# ENGRAM_LOG_RESULT_DENIED=denied
# ENGRAM_LOG_RESULT_ERROR=error

# --- Azure Blob (optional until audio persistence) ---
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_BLOB_CONTAINER=
# AZURE_BLOB_KEY_PREFIX=voice/
# Override the blob endpoint (sovereign cloud, custom domain, or the local
# Azurite emulator, e.g. http://127.0.0.1:10000/devstoreaccount1).
# AZURE_BLOB_ENDPOINT=

# --- Deepgram (optional until the voice loop) ---
# DEEPGRAM_API_KEY=
DEEPGRAM_API_BASE_URL=https://api.deepgram.com
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_STT_LANGUAGE=en
# Aura-2 model id. Do not omit speak later or Deepgram falls back to Flux.
DEEPGRAM_TTS_VOICE=aura-2-athena-en
# DEEPGRAM_AGENT_WSS_URL=wss://agent.deepgram.com/v1/agent/converse
# DEEPGRAM_AGENT_AUTH_HEADER=Authorization
# DEEPGRAM_AGENT_AUTH_SCHEME=Token
# DEEPGRAM_AUDIO_INPUT_ENCODING=linear16
# DEEPGRAM_AUDIO_INPUT_SAMPLE_RATE=16000
# DEEPGRAM_AUDIO_OUTPUT_ENCODING=linear16
# DEEPGRAM_AUDIO_OUTPUT_SAMPLE_RATE=24000
# DEEPGRAM_AUDIO_OUTPUT_CONTAINER=none
# DEEPGRAM_LISTEN_PROVIDER_TYPE=deepgram
# DEEPGRAM_LISTEN_PROVIDER_VERSION=v1
# DEEPGRAM_THINK_PROVIDER_TYPE=open_ai
# DEEPGRAM_THINK_MODEL=gpt-4o-mini
# DEEPGRAM_THINK_PROMPT=
# DEEPGRAM_SPEAK_PROVIDER_TYPE=deepgram
# DEEPGRAM_SPEAK_PROVIDER_VERSION=v1
# DEEPGRAM_AGENT_GREETING=
# DEEPGRAM_AGENT_HANDSHAKE_TIMEOUT_MS=20000
# One reconnect after the transport drops, then an honest end.
# DEEPGRAM_RECONNECT_ATTEMPTS=1
# DEEPGRAM_RECONNECT_BACKOFF_MS=750
# Structured Deepgram Error codes that are worth another handshake.
# DEEPGRAM_RECONNECT_ON_CODES=INTERNAL_SERVER_ERROR,CLIENT_MESSAGE_TIMEOUT,FAILED_TO_START_LISTENING,ASR_CONNECTION_CLOSED,ASR_DRIVER_TIMEOUT,SERVER_GOING_AWAY
# DEEPGRAM_THINK_FATAL_CODES=FAILED_TO_THINK
# DEEPGRAM_KEEP_ALIVE_INTERVAL_MS=8000
# VOICE_WS_PATH=/ws/voice
# VOICE_REDIS_KEY_PREFIX=voice-call:
# VOICE_REDIS_TTL_SECONDS=3600
# DEEPGRAM_MSG_AGENT_THINKING=AgentThinking
# DEEPGRAM_MSG_AGENT_AUDIO_DONE=AgentAudioDone
# DEEPGRAM_MSG_CONVERSATION_TEXT=ConversationText
# VOICE_TRANSCRIPT_USER_ROLE=user
# DEEPGRAM_MSG_LATENCY_REPORT=LatencyReport
# DEEPGRAM_LATENCY_STT_FIELD=stt_latency
# DEEPGRAM_LATENCY_TTS_FIELD=tts_latency
# VOICE_LATENCY_TO_MS=1000
# Reports held while their turn row is still being written.
# VOICE_PENDING_LATENCY_MAX=8
# Transport warning codes logged but not forwarded to the browser.
# VOICE_SUPPRESSED_WARNING_CODES=SLOW_THINK_REQUEST
# REDIS_COMMAND_TIMEOUT_MS=500
# VOICE_NOTICE_REDIS_CHANNEL=voice-notice
# Client-facing failure codes and copy. Same keys are read by the worker.
# FAILURE_CODE_ENGRAM=engram_unavailable
# FAILURE_CODE_SPEAKING_LLM=speaking_llm_failed
# FAILURE_CODE_RECORD=record_lost
# FAILURE_CODE_DEEPGRAM=deepgram_unavailable
# FAILURE_CODE_BLOB=audio_not_stored
# FAILURE_CODE_REDIS=call_state_degraded
# FAILURE_CODE_RECONNECTING=voice_reconnecting
# FAILURE_CODE_RECONNECTED=voice_reconnected
# FAILURE_CODE_DATABASE=database_unavailable
# FAILURE_CODE_THINK=think_failed
# FAILURE_MESSAGE_ENGRAM=The persona's memory is unavailable. Nothing was invented in its place.
# FAILURE_MESSAGE_SPEAKING_LLM=The reply stopped early. You heard only the words that were produced.
# FAILURE_MESSAGE_RECORD=The reply was delivered but the conversation record could not be saved.
# FAILURE_MESSAGE_DEEPGRAM=The voice connection could not be restored.
# FAILURE_MESSAGE_BLOB=Call audio is not being stored. The conversation continues.
# FAILURE_MESSAGE_REDIS=Call state is running without the cache. The conversation continues.
# FAILURE_MESSAGE_RECONNECTING=The voice connection dropped. Reconnecting…
# FAILURE_MESSAGE_RECONNECTED=Voice connection restored.
# FAILURE_MESSAGE_DATABASE=The conversation record is unavailable. This turn could not start.
# FAILURE_MESSAGE_THINK=The persona could not answer. The call has ended.
# FAILURE_MESSAGE_UNKNOWN=Something went wrong.
# FAILURE_FATAL_CODES=engram_unavailable,deepgram_unavailable,think_failed,database_unavailable
# Voice audio to Azure Blob. Enabled here but skipped (with a warning) until
# the three AZURE_ keys above are set.
# VOICE_AUDIO_PERSIST_ENABLED=true
# VOICE_AUDIO_FORMAT=wav
# VOICE_AUDIO_CONTENT_TYPE=audio/wav
# VOICE_AUDIO_BITS_PER_SAMPLE=16
# VOICE_AUDIO_MAX_BYTES=16777216
# VOICE_PROBE_FRAME_MS=20
# VOICE_PROBE_SETTLE_MS=5000
# VOICE_INJECT_TIMEOUT_MS=180000
# VOICE_INJECT_TEXT=Please remember that my voice probe token is lantern-voice.

# --- BYO-LLM Chat Completions (worker; Deepgram think endpoint) ---
BYO_LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
BYO_LLM_APP_USER_HEADER=x-app-user-id
BYO_LLM_ENGRAM_USER_HEADER=x-engram-user-id
BYO_LLM_PERSONA_HEADER=x-persona-id
BYO_LLM_SESSION_HEADER=x-session-id
# BYO_LLM_USER_ROLE=user
# BYO_LLM_ASSISTANT_ROLE=assistant
# BYO_LLM_TEXT_PART_TYPE=text
# BYO_LLM_COMPLETION_OBJECT=chat.completion
# BYO_LLM_CHUNK_OBJECT=chat.completion.chunk
# BYO_LLM_FINISH_REASON=stop
# BYO_LLM_COMPLETION_ID_PREFIX=chatcmpl-
# BYO_LLM_SSE_DONE=[DONE]
# BYO_LLM_SSE_MEDIA_TYPE=text/event-stream
# Spoken greeting is omitted unless you later set a config string for it.

# Space- or comma-separated Google emails allowed to use /admin.
# OWNER_EMAILS=you@example.com

# --- Engram (optional until the brain) ---
# ENGRAM_API_KEY=
# ENGRAM_ORG_ID=
# ENGRAM_BASE_URL=https://api-engram-alpha.getmetacognition.com
# ENGRAM_TIMEOUT_SECONDS=120
# ENGRAM_MESSAGE_JOIN= 
# ENGRAM_READ_MAX_RETRIES=2
# Open Engram clients kept warm, one per user. Saves a TLS handshake per turn.
# ENGRAM_CLIENT_CACHE_SIZE=8
# Which brain answers a turn. "retrieve" (default) reads memory and composes
# the reply here, writing the turn back with converse (~2.5s to first word).
# "chat" asks Engram to compose it instead (~12.5s). Memory lives in Engram
# either way; compare the two with `npm run brains`.
# BRAIN_MODE=retrieve
# ENGRAM_RETRIEVE_TOP_K=25
# ENGRAM_CONVERSE_WRITEBACK=true
# ENGRAM_CONVERSE_USER_SPEAKER=user
# ENGRAM_CONVERSE_PERSONA_SPEAKER=persona
# ENGRAM_WRITEBACK_WORKERS=2
# Optional seed when the local personas table is empty. Never the active-persona resolver.
# ENGRAM_PERSONA_ID=
# Query/body field that pins a sitting to a local persona UUID (chat, voice, memory).
# PERSONA_ID_QUERY=persona_id
# Key inside personas.voice_config for the Deepgram TTS voice id.
# PERSONA_VOICE_TTS_KEY=tts_voice
# ADMIN_ERROR_PERSONA_PIN_REQUIRED=persona_id is required when several personas exist
# ADMIN_ERROR_CREATE_FORBIDDEN=Engram refused create; record a dashboard persona id instead
# Missing or unpublished persona uses the same 404 copy as a missing session.
# INSIGHTS_ERROR_NOT_FOUND=session not found

# --- Reframe LLM (optional until the brain) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# OPENAI_API_BASE_URL=https://api.openai.com
# REFRAME_HISTORY_TURNS=8
# REFRAME_TEMPERATURE=0.2
# REFRAME_MAX_TOKENS=256
# REFRAME_TIMEOUT_SECONDS=30
# Stream the reframe so the voice transport speaks on the first token.
# REFRAME_STREAM_ENABLED=true
# REFRAME_SYSTEM_PROMPT=
# Used only when BRAIN_MODE=retrieve.
# ANSWER_SYSTEM_PROMPT=
# ANSWER_MAX_TOKENS=320

# --- Worker Postgres pool (connections are reused across turns) ---
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=8
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_MAX_IDLE_SECONDS=300
