# Copy to `.env` in this directory. Never commit `.env`.
# Gateway and worker load this file. Vite (frontend) reads it too; only VITE_* reach the browser.
#
# Required to boot gateway now: local URLs/secrets below + Google Sign-In.
# Optional until later parts: Azure, Deepgram, Engram, OpenAI, BYO_LLM_PUBLIC_URL.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Public URLs / bind ---
GATEWAY_HOST=0.0.0.0
# Bind port for the gateway process. Do not use 4000 if Engram's API is already there.
GATEWAY_PORT=4100
# Browser-facing origin. Vite proxies /auth /api /ws to GATEWAY_PORT.
GATEWAY_PUBLIC_URL=http://localhost:5188
FRONTEND_ORIGIN=http://localhost:5188
CORS_ALLOWED_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE
# Per-IP request rate limit on the gateway (Redis-backed, fails open on a Redis error).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_REDIS_PREFIX=ratelimit:
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
WORKER_URL=http://localhost:8000
# OpenAPI UI on the worker. Off: the think endpoint is publicly reachable.
# WORKER_OPENAPI_ENABLED=false
# Public URL Deepgram will call for BYO-LLM (dev: tunnel to the worker, not the gateway; Azure: public worker URL)
# Example local tunnel: ngrok http 8000   then set this to the https origin ngrok prints.
# BYO_LLM_PUBLIC_URL=
# Optional extra think-endpoint headers (JSON object). Needed for some tunnels:
# BYO_LLM_ENDPOINT_EXTRA_HEADERS={"ngrok-skip-browser-warning":"true"}

# --- Frontend (browser-safe; Vite exposes only VITE_*) ---
VITE_GATEWAY_URL=http://localhost:5188
VITE_CHAT_SESSION_STORAGE_KEY=vb-chat-session
VITE_VOICE_WS_PATH=/ws/voice
VITE_DEEPGRAM_AUDIO_INPUT_ENCODING=linear16
VITE_DEEPGRAM_AUDIO_INPUT_SAMPLE_RATE=16000
VITE_DEEPGRAM_AUDIO_OUTPUT_ENCODING=linear16
VITE_DEEPGRAM_AUDIO_OUTPUT_SAMPLE_RATE=24000
VITE_VOICE_CHANNEL_COUNT=1
VITE_VOICE_CAPTURE_FRAME_SAMPLES=320
VITE_VOICE_ECHO_CANCELLATION=true
VITE_VOICE_WORKLET_NAME=voice-capture
VITE_VOICE_CLIENT_READY_TYPE=voice.ready
VITE_VOICE_CLIENT_ERROR_TYPE=voice.error
VITE_VOICE_CLIENT_WARNING_TYPE=voice.warning
VITE_VOICE_CLIENT_AGENT_EVENT_TYPE=voice.agent
VITE_DEEPGRAM_MSG_CONVERSATION_TEXT=ConversationText
VITE_DEEPGRAM_MSG_USER_STARTED=UserStartedSpeaking
VITE_DEEPGRAM_MSG_AGENT_THINKING=AgentThinking
VITE_DEEPGRAM_MSG_AGENT_AUDIO_DONE=AgentAudioDone
VITE_VOICE_TRANSCRIPT_USER_ROLE=user
VITE_VOICE_TRANSCRIPT_ASSISTANT_ROLE=assistant
VITE_VOICE_VU_BAR_COUNT=24
VITE_VOICE_THINKING_CUE_ENABLED=true
VITE_VOICE_THINKING_CUE_URL=/thinking-cue.wav
VITE_VOICE_THINKING_CUE_LOOP=true
VITE_VOICE_THINKING_CUE_INTERVAL_MS=4000
VITE_VOICE_THINKING_CUE_MAX_MS=20000
VITE_VOICE_THINKING_CUE_LABEL=Thinking…
VITE_FAILURE_CODE_RECONNECTING=voice_reconnecting
VITE_FAILURE_CODE_RECONNECTED=voice_reconnected
VITE_VOICE_CONNECTION_DROPPED=The voice connection dropped
VITE_CHAT_SILENCE_STATUS=The persona stayed silent.
VITE_TURN_SPEAKER_USER=user
VITE_TURN_SPEAKER_PERSONA=persona
VITE_APP_NAME=Voice
# id|label|icon|route-key  (route-key is a key in frontend/src/lib/routes.ts)
VITE_NAV_ITEMS=home|Home|home|dashboard;chat|Chat|chat|chat;voice|Voice|ai-spark|voice
VITE_NAV_OWNER_ITEMS=admin|Admin|settings|admin
VITE_ADMIN_NAV_ITEMS=overview|Overview|dashboard|admin;conversations|Conversations|history|adminConversations;people|People|users|adminPeople;persona|Persona|spaces|adminPersona
VITE_SIGNOUT_LABEL=Sign out
VITE_LOADING_LABEL=Loading…
VITE_SIGNIN_CONTINUE=Continue with Google
VITE_NOT_OWNER_MESSAGE=This account is not an owner.
VITE_SIGNIN_TITLE_CHAT=Chat
VITE_SIGNIN_BODY_CHAT=Sign in with Google to talk to the persona.
VITE_SIGNIN_TITLE_VOICE=Voice
VITE_SIGNIN_BODY_VOICE=Sign in with Google to talk to the persona.
VITE_SIGNIN_TITLE_PERSONA=Persona
VITE_SIGNIN_BODY_PERSONA=Sign in with Google to manage the persona.
VITE_SIGNIN_TITLE_ADMIN=Admin
VITE_SIGNIN_BODY_ADMIN=Sign in with Google to manage the persona.
VITE_SIGNIN_TITLE_APP=Sign in
VITE_SIGNIN_BODY_APP=Sign in with Google to continue.
VITE_INSIGHTS_RANGE_LABELS=today|Today;7d|7 days;30d|30 days
VITE_INSIGHTS_DEFAULT_RANGE=7d
VITE_INSIGHTS_DEFAULT_BUCKET=day
VITE_LATENCY_BUDGET_FIRST_WORD_MS=4000
VITE_FILTER_ANY=*
VITE_CHANNEL_FILTERS=*|All;text|Chat;voice|Voice
VITE_STAGE_LABELS=stt_ms|STT;brain_ms|Brain;reframe_first_token_ms|First word;tts_first_byte_ms|TTS
VITE_BRAIN_MODE_LABELS=retrieve|Retrieve;chat|Chat;unrecorded|Unrecorded;mixed|Mixed
VITE_KPI_CALLS_LABEL=Calls
VITE_KPI_TURNS_LABEL=Turns
VITE_KPI_FIRST_WORD_LABEL=Median first word
VITE_KPI_ERROR_RATE_LABEL=Error rate
VITE_KPI_CALLS_ICON=history
VITE_KPI_TURNS_ICON=chat
VITE_KPI_FIRST_WORD_ICON=dashboard
VITE_KPI_ERROR_RATE_ICON=shield
VITE_GRAPH_TURNS_LABEL=Turns
VITE_GRAPH_SESSIONS_LABEL=Calls
VITE_EMPTY_RANGE=No activity in this range.
VITE_EMPTY_LIST=No conversations yet.
VITE_EMPTY_TRANSCRIPT=This conversation has no spoken turns.
VITE_EMPTY_MEMORY=Nothing stored about you yet.
VITE_FETCH_ERROR=Could not load this view.
VITE_RETRY_LABEL=Retry
VITE_LOAD_MORE_LABEL=Load more
VITE_SESSION_ENDED_LABEL=Ended
VITE_SESSION_OPEN_LABEL=Open
VITE_SUBSCRIPTION_NOTE=Subscription is recorded for visibility. It is not an access gate.
VITE_SUBSCRIPTION_NONE=none
VITE_MS_UNIT=ms
VITE_SECOND_UNIT=s
VITE_PERCENT_UNIT=%
VITE_AUDIO_ABSENT=No audio stored for this turn.
VITE_AUDIO_USER_LABEL=You
VITE_AUDIO_BOT_LABEL=Persona
VITE_AUDIO_DIRECTION_USER=user
VITE_AUDIO_DIRECTION_BOT=bot
VITE_REASONS_LABEL=Reasons
VITE_ACTION_LABEL=Action
VITE_LATENCY_LABEL=Timings
VITE_MEMORY_REFS_LABEL=Memory refs
VITE_CORRELATION_LABEL=Trace id
VITE_BACK_LABEL=Back
VITE_MEMORY_PANEL_TITLE=What it remembers about you
VITE_MEMORY_PANEL_UNAVAILABLE=Memory is unavailable right now. Your history is still here.
VITE_MEMORY_PANEL_ENABLED=true
VITE_PEOPLE_TITLE=People
VITE_CONVERSATIONS_TITLE=Conversations
VITE_OVERVIEW_ACTIVITY_TITLE=Activity
VITE_OVERVIEW_LATENCY_TITLE=Latency
VITE_OVERVIEW_BUDGET_LABEL=Budget
VITE_RECENT_TITLE=Your conversations
MEMORY_PANEL_QUERY=What do you remember about this caller?
MEMORY_PANEL_TOP_K=25
MEMORY_PANEL_ENABLED=true

# --- Postgres / Redis (Compose). DATABASE_URL / REDIS_URL must match host ports. ---
# If 5432 or 6379 is already in use on the machine, change POSTGRES_PORT / REDIS_PORT and the URLs together.
POSTGRES_USER=voicebot
POSTGRES_PASSWORD=voicebot
POSTGRES_DB=voicebot
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://voicebot:voicebot@localhost:5432/voicebot
REDIS_URL=redis://localhost:6379

# --- Session (min 16 characters) ---
SESSION_SECRET=replace-with-at-least-16-chars
# Shared secret for gateway ↔ worker. Dedicated; do not reuse SESSION_SECRET.
INTERNAL_API_SECRET=replace-with-a-long-random-secret
# Brute-force throttle on the worker's internal-secret guard. Only failed
# authentications are counted, keyed by client address (Redis-backed, fails open).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REDIS_PREFIX=ratelimit:
# INTERNAL_AUTH_MAX_FAILURES=20
# INTERNAL_AUTH_FAILURE_WINDOW_SECONDS=60

# --- Google Sign-In (required now). Redirect must match this URL in Google Cloud Console. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5188/auth/google/callback
GOOGLE_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
GOOGLE_SCOPES=openid email profile
GOOGLE_AUTH_PROMPT=select_account
GOOGLE_REQUIRE_EMAIL_VERIFIED=true
# GOOGLE_ID_TOKEN_ISSUERS=https://accounts.google.com accounts.google.com
GOOGLE_PKCE_METHOD=S256
SESSION_COOKIE_NAME=vb_session
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=604800
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=none requires a secure cookie (production or SESSION_COOKIE_SECURE=true).
SESSION_REDIS_KEY_PREFIX=session:
CHAT_ACTIVITY_REDIS_KEY_PREFIX=chat-activity:
CHAT_ACTIVITY_TTL_SECONDS=86400
SESSION_ID_BYTES=32
OAUTH_REDIS_KEY_PREFIX=oauth:
OAUTH_PENDING_TTL_SECONDS=600
OAUTH_TOKEN_BYTES=32
OIDC_DISCOVERY_TTL_SECONDS=3600
OIDC_CLOCK_TOLERANCE_SECONDS=60
OIDC_HTTP_TIMEOUT_MS=10000
WORKER_HTTP_TIMEOUT_MS=120000
INTERNAL_SECRET_HEADER=x-internal-secret
OWNER_EMAILS=
ADMIN_INGEST_MAX_BYTES=8388608
POST_LOGIN_REDIRECT_URL=http://localhost:5188/dashboard

# --- Read API (canonical record) ---
# INSIGHTS_PAGE_SIZE=50
# INSIGHTS_MAX_PAGE_SIZE=200
# INSIGHTS_RANGES=today,7d,30d
# INSIGHTS_DEFAULT_RANGE=7d
# Window spec: <id>:<calendar-token> or <id>:<days>
# INSIGHTS_RANGE_WINDOWS=today:calendar,7d:7,30d:30
# INSIGHTS_CALENDAR_WINDOW_SPEC=calendar
# INSIGHTS_TIMEZONE=UTC
# INSIGHTS_ACTIVITY_BUCKETS=hour,day
# INSIGHTS_DEFAULT_BUCKET=day
# INSIGHTS_ERROR_REASONS=server_error,retryable_read,brain_error
# INSIGHTS_BRAIN_MODE_UNRECORDED=unrecorded
# INSIGHTS_BRAIN_MODE_MIXED=mixed
# INSIGHTS_FIRST_WORD_COLUMNS=brain_ms,reframe_first_token_ms
# INSIGHTS_FIRST_WORD_REQUIRED_COLUMN=reframe_first_token_ms
# INSIGHTS_LATENCY_STAGES=stt_ms,brain_ms,reframe_first_token_ms,tts_first_byte_ms
# LATENCY_BUDGET_FIRST_WORD_MS=4000
# LATENCY_BUDGET_P90_MS=8000
# LATENCY_BUDGET_WINDOW_HOURS=24
# LATENCY_BUDGET_BY_BRAIN_MODE={"retrieve":{"p50":4000,"p90":8000},"chat":{"p50":20000,"p90":30000}}
# CORRELATION_ID_HEADER=x-correlation-id
# LOG_TURN_FIELDS=correlation_id,session_id,turn_ids,action,reasons,brain_ms,reframe_ms,reframe_first_token_ms,brain_mode,recorded
# LOG_TURN_EVENT=turn
# VOICE_NOTICE_KIND_TRACE=trace
# VOICE_NOTICE_TRACE_CODE=turn_traced
# VOICE_NOTICE_TRACE_MESSAGE=Turn recorded.
# ENGRAM_LOGS_LIMIT=50
# Structured `result` values Engram stores on request-log rows.
# ENGRAM_LOG_RESULT_DENIED=denied
# ENGRAM_LOG_RESULT_ERROR=error

# --- Azure Blob (optional until audio persistence) ---
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_BLOB_CONTAINER=
# AZURE_BLOB_KEY_PREFIX=voice/
# Override the blob endpoint (sovereign cloud, custom domain, or the local
# Azurite emulator, e.g. http://127.0.0.1:10000/devstoreaccount1).
# AZURE_BLOB_ENDPOINT=

# --- Deepgram (optional until the voice loop) ---
# DEEPGRAM_API_KEY=
DEEPGRAM_API_BASE_URL=https://api.deepgram.com
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_STT_LANGUAGE=en
# Aura-2 model id. Do not omit speak later or Deepgram falls back to Flux.
DEEPGRAM_TTS_VOICE=aura-2-athena-en
# DEEPGRAM_AGENT_WSS_URL=wss://agent.deepgram.com/v1/agent/converse
# DEEPGRAM_AGENT_AUTH_HEADER=Authorization
# DEEPGRAM_AGENT_AUTH_SCHEME=Token
# DEEPGRAM_AUDIO_INPUT_ENCODING=linear16
# DEEPGRAM_AUDIO_INPUT_SAMPLE_RATE=16000
# DEEPGRAM_AUDIO_OUTPUT_ENCODING=linear16
# DEEPGRAM_AUDIO_OUTPUT_SAMPLE_RATE=24000
# DEEPGRAM_AUDIO_OUTPUT_CONTAINER=none
# DEEPGRAM_LISTEN_PROVIDER_TYPE=deepgram
# DEEPGRAM_LISTEN_PROVIDER_VERSION=v1
# DEEPGRAM_THINK_PROVIDER_TYPE=open_ai
# DEEPGRAM_THINK_MODEL=gpt-4o-mini
# DEEPGRAM_THINK_PROMPT=
# DEEPGRAM_SPEAK_PROVIDER_TYPE=deepgram
# DEEPGRAM_SPEAK_PROVIDER_VERSION=v1
# DEEPGRAM_AGENT_GREETING=
# DEEPGRAM_AGENT_HANDSHAKE_TIMEOUT_MS=20000
# One reconnect after the transport drops, then an honest end.
# DEEPGRAM_RECONNECT_ATTEMPTS=1
# DEEPGRAM_RECONNECT_BACKOFF_MS=750
# Structured Deepgram Error codes that are worth another handshake.
# DEEPGRAM_RECONNECT_ON_CODES=INTERNAL_SERVER_ERROR,CLIENT_MESSAGE_TIMEOUT,FAILED_TO_START_LISTENING,ASR_CONNECTION_CLOSED,ASR_DRIVER_TIMEOUT,SERVER_GOING_AWAY
# DEEPGRAM_THINK_FATAL_CODES=FAILED_TO_THINK
# DEEPGRAM_KEEP_ALIVE_INTERVAL_MS=8000
# VOICE_WS_PATH=/ws/voice
# VOICE_REDIS_KEY_PREFIX=voice-call:
# VOICE_REDIS_TTL_SECONDS=3600
# DEEPGRAM_MSG_AGENT_THINKING=AgentThinking
# DEEPGRAM_MSG_AGENT_AUDIO_DONE=AgentAudioDone
# DEEPGRAM_MSG_CONVERSATION_TEXT=ConversationText
# VOICE_TRANSCRIPT_USER_ROLE=user
# DEEPGRAM_MSG_LATENCY_REPORT=LatencyReport
# DEEPGRAM_LATENCY_STT_FIELD=stt_latency
# DEEPGRAM_LATENCY_TTS_FIELD=tts_latency
# VOICE_LATENCY_TO_MS=1000
# Reports held while their turn row is still being written.
# VOICE_PENDING_LATENCY_MAX=8
# Transport warning codes logged but not forwarded to the browser.
# VOICE_SUPPRESSED_WARNING_CODES=SLOW_THINK_REQUEST
# REDIS_COMMAND_TIMEOUT_MS=500
# VOICE_NOTICE_REDIS_CHANNEL=voice-notice
# Client-facing failure codes and copy. Same keys are read by the worker.
# FAILURE_CODE_ENGRAM=engram_unavailable
# FAILURE_CODE_SPEAKING_LLM=speaking_llm_failed
# FAILURE_CODE_RECORD=record_lost
# FAILURE_CODE_DEEPGRAM=deepgram_unavailable
# FAILURE_CODE_BLOB=audio_not_stored
# FAILURE_CODE_REDIS=call_state_degraded
# FAILURE_CODE_RECONNECTING=voice_reconnecting
# FAILURE_CODE_RECONNECTED=voice_reconnected
# FAILURE_CODE_DATABASE=database_unavailable
# FAILURE_CODE_THINK=think_failed
# FAILURE_MESSAGE_ENGRAM=The persona's memory is unavailable. Nothing was invented in its place.
# FAILURE_MESSAGE_SPEAKING_LLM=The reply stopped early. You heard only the words that were produced.
# FAILURE_MESSAGE_RECORD=The reply was delivered but the conversation record could not be saved.
# FAILURE_MESSAGE_DEEPGRAM=The voice connection could not be restored.
# FAILURE_MESSAGE_BLOB=Call audio is not being stored. The conversation continues.
# FAILURE_MESSAGE_REDIS=Call state is running without the cache. The conversation continues.
# FAILURE_MESSAGE_RECONNECTING=The voice connection dropped. Reconnecting…
# FAILURE_MESSAGE_RECONNECTED=Voice connection restored.
# FAILURE_MESSAGE_DATABASE=The conversation record is unavailable. This turn could not start.
# FAILURE_MESSAGE_THINK=The persona could not answer. The call has ended.
# FAILURE_MESSAGE_UNKNOWN=Something went wrong.
# FAILURE_FATAL_CODES=engram_unavailable,deepgram_unavailable,think_failed,database_unavailable
# Voice audio to Azure Blob. Enabled here but skipped (with a warning) until
# the three AZURE_ keys above are set.
# VOICE_AUDIO_PERSIST_ENABLED=true
# VOICE_AUDIO_FORMAT=wav
# VOICE_AUDIO_CONTENT_TYPE=audio/wav
# VOICE_AUDIO_BITS_PER_SAMPLE=16
# VOICE_AUDIO_MAX_BYTES=16777216
# VOICE_PROBE_FRAME_MS=20
# VOICE_PROBE_SETTLE_MS=5000
# VOICE_INJECT_TIMEOUT_MS=180000
# VOICE_INJECT_TEXT=Please remember that my voice probe token is lantern-voice.

# --- BYO-LLM Chat Completions (worker; Deepgram think endpoint) ---
BYO_LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
BYO_LLM_APP_USER_HEADER=x-app-user-id
BYO_LLM_ENGRAM_USER_HEADER=x-engram-user-id
BYO_LLM_PERSONA_HEADER=x-persona-id
BYO_LLM_SESSION_HEADER=x-session-id
# BYO_LLM_USER_ROLE=user
# BYO_LLM_ASSISTANT_ROLE=assistant
# BYO_LLM_TEXT_PART_TYPE=text
# BYO_LLM_COMPLETION_OBJECT=chat.completion
# BYO_LLM_CHUNK_OBJECT=chat.completion.chunk
# BYO_LLM_FINISH_REASON=stop
# BYO_LLM_COMPLETION_ID_PREFIX=chatcmpl-
# BYO_LLM_SSE_DONE=[DONE]
# BYO_LLM_SSE_MEDIA_TYPE=text/event-stream
# Spoken greeting is omitted unless you later set a config string for it.

# Space- or comma-separated Google emails allowed to use /admin.
# OWNER_EMAILS=you@example.com

# --- Engram (optional until the brain) ---
# ENGRAM_API_KEY=
# ENGRAM_ORG_ID=
# ENGRAM_BASE_URL=https://api-engram-alpha.getmetacognition.com
# ENGRAM_TIMEOUT_SECONDS=120
# ENGRAM_MESSAGE_JOIN= 
# ENGRAM_READ_MAX_RETRIES=2
# Open Engram clients kept warm, one per user. Saves a TLS handshake per turn.
# ENGRAM_CLIENT_CACHE_SIZE=8
# Which brain answers a turn. "retrieve" (default) reads memory and composes
# the reply here, writing the turn back with converse (~2.5s to first word).
# "chat" asks Engram to compose it instead (~12.5s). Memory lives in Engram
# either way; compare the two with `npm run brains`.
# BRAIN_MODE=retrieve
# ENGRAM_RETRIEVE_TOP_K=25
# ENGRAM_CONVERSE_WRITEBACK=true
# ENGRAM_CONVERSE_USER_SPEAKER=user
# ENGRAM_CONVERSE_PERSONA_SPEAKER=persona
# ENGRAM_WRITEBACK_WORKERS=2
# Persona id from the Engram dashboard (API keys cannot create personas).
# ENGRAM_PERSONA_ID=

# --- Reframe LLM (optional until the brain) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# OPENAI_API_BASE_URL=https://api.openai.com
# REFRAME_HISTORY_TURNS=8
# REFRAME_TEMPERATURE=0.2
# REFRAME_MAX_TOKENS=256
# REFRAME_TIMEOUT_SECONDS=30
# Stream the reframe so the voice transport speaks on the first token.
# REFRAME_STREAM_ENABLED=true
# REFRAME_SYSTEM_PROMPT=
# Used only when BRAIN_MODE=retrieve.
# ANSWER_SYSTEM_PROMPT=
# ANSWER_MAX_TOKENS=320

# --- Worker Postgres pool (connections are reused across turns) ---
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=8
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_MAX_IDLE_SECONDS=300
